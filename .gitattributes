# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Python files
*.py text eol=lf

# Config & data files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.env text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files — no line ending conversion
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tiff binary
*.webp binary
*.pkl binary
*.faiss binary
*.npy binary
*.npz binary
